    "rulesSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://legacy.plus/schemas/legacyplus-client-xp-rules.v1.json",
      "title": "LEGACY+ Client XP Rules Engine Schema v1",
      "type": "object",
      "required": [
        "metadata",
        "settings",
        "xpCurve",
        "actions"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "systemName",
            "version",
            "timezone",
            "region",
            "effectiveDate"
          ],
          "properties": {
            "systemName": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "effectiveDate": {
              "type": "string",
              "format": "date"
            },
            "sourceWorkbook": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "settings": {
          "type": "object",
          "required": [
            "routineWeeklyCapXP",
            "monthlyCoinCap",
            "coinValueRM",
            "weekStart",
            "countOnlyVerified"
          ],
          "properties": {
            "routineWeeklyCapXP": {
              "type": "integer",
              "minimum": 0
            },
            "monthlyCoinCap": {
              "type": "integer",
              "minimum": 0
            },
            "coinValueRM": {
              "type": "number",
              "minimum": 0
            },
            "weekStart": {
              "type": "string",
              "enum": [
                "MON",
                "SUN"
              ]
            },
            "countOnlyVerified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "xpCurve": {
          "type": "object",
          "required": [
            "type",
            "maxLevel",
            "xpAtMaxLevel",
            "formula",
            "levelFromXP"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "quadratic_n_squared"
              ]
            },
            "maxLevel": {
              "type": "integer",
              "minimum": 1
            },
            "xpAtMaxLevel": {
              "type": "integer",
              "minimum": 1
            },
            "formula": {
              "type": "string"
            },
            "levelFromXP": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "actionId",
              "displayName",
              "category",
              "earnType",
              "xp",
              "coins",
              "verificationRequired"
            ],
            "properties": {
              "actionId": {
                "type": "string",
                "pattern": "^[A-Z0-9\\-]{3,30}$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "earnType": {
                "type": "string",
                "enum": [
                  "Routine",
                  "Milestone",
                  "Achievement",
                  "Boss"
                ]
              },
              "xp": {
                "type": "integer",
                "minimum": 0
              },
              "coins": {
                "type": "integer",
                "minimum": 0
              },
              "cap": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "period",
                      "maxCount"
                    ],
                    "properties": {
                      "period": {
                        "type": "string",
                        "enum": [
                          "None",
                          "Daily",
                          "Weekly",
                          "Monthly",
                          "Quarterly",
                          "Yearly",
                          "OneTime"
                        ]
                      },
                      "maxCount": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "cooldownDays": {
                "type": "integer",
                "minimum": 0
              },
              "verificationRequired": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "importContract": {
      "contractVersion": "legacyplus.clients.workbook.v2",
      "workbook": {
        "filename": "LEGACY+_XP_System_v2_FIXED.xlsx",
        "timezone": "Asia/Kuala_Lumpur",
        "weekStart": "MON"
      },
      "normalization": {
        "trimHeaders": true,
        "trimStrings": true,
        "emptyToNull": true,
        "yesNoToBoolean": {
          "Yes": true,
          "No": false,
          "": null
        }
      },
      "entities": {
        "settings": {
          "sourceSheet": "Settings",
          "kvColumns": {
            "key": "Name",
            "value": "Value"
          },
          "requiredKeys": [
            "RoutineWeeklyCapXP",
            "MonthlyCoinCap",
            "CoinValueRM"
          ]
        },
        "members": {
          "sourceSheet": "Members",
          "primaryKey": "member_id",
          "columns": {
            "member_id": "MemberID",
            "member_name": "Member Name",
            "mode": "Mode",
            "status": "Status"
          },
          "requiredColumns": [
            "MemberID",
            "Member Name",
            "Mode",
            "Status"
          ],
          "notes": "Ignore helper column ActiveMemberIDs; compute active list where status == 'Active'."
        },
        "actions": {
          "sourceSheets": {
            "rules": "ActionsCatalog",
            "display": "ActionMap"
          },
          "primaryKey": "action_id",
          "rulesColumns": {
            "action_id": "ActionID",
            "earn_type": "Type",
            "xp": "XP",
            "coins_per": "CoinsPer",
            "display_name": "Display Name",
            "category": "Category"
          },
          "displayColumns": {
            "display_name_coach_sees": "Display Name (Coach sees)",
            "action_id": "ActionID",
            "xp": "XP",
            "coins": "Coins",
            "category": "Type"
          },
          "requiredRulesColumns": [
            "ActionID",
            "Type",
            "XP",
            "CoinsPer",
            "Display Name",
            "Category"
          ],
          "requiredDisplayColumns": [
            "Display Name (Coach sees)",
            "ActionID",
            "XP",
            "Coins",
            "Type"
          ],
          "validation": {
            "mustMatchOnActionId": [
              "xp",
              "coins"
            ],
            "mustHaveUnique": [
              "ActionID"
            ],
            "earnTypeEnum": [
              "Routine",
              "Milestone",
              "Achievement",
              "Boss"
            ]
          }
        },
        "events": {
          "sourceSheet": "QuickLog",
          "primaryKey": "event_id",
          "appendOnly": true,
          "inputColumns": {
            "date": "Date",
            "member_id": "MemberID",
            "action_id": "Action ID",
            "qty": "Qty",
            "verified": "Verified",
            "coach": "Coach",
            "notes": "Notes"
          },
          "optionalColumns": {
            "action_name": "Action Name",
            "mode": "Mode",
            "member_name": "Member Name"
          },
          "computedDoNotImportAsTruth": [
            "Type",
            "XP Per",
            "Coins Per",
            "XP Raw",
            "Coins Raw",
            "Week Key",
            "MonthKey"
          ],
          "rowInclusionRule": "Include row if Date OR MemberID OR Action ID is non-empty; ignore completely blank rows."
        },
        "seedPlacement": {
          "sourceSheet": "SeedPlacement",
          "primaryKey": "member_id",
          "columns": {
            "member_id": "MemberID",
            "months_coached": "MonthsCoached",
            "avg_sessions_per_week": "AvgSessionsPerWeek",
            "adherence_score": "AdherenceScore (1–5)",
            "movement_competency": "MovementCompetency (1–5)",
            "strength_level": "StrengthLevel (1–5)",
            "lifestyle_habits": "LifestyleHabits (1–5)",
            "tracking_consistency": "TrackingConsistency (1–5)",
            "self_mastery": "SelfMastery (1–5)",
            "knowledge_level": "KnowledgeLevel (1–5)",
            "seed_xp_calc": "SeedXP_Calc",
            "seed_level_calc": "SeedLevel (calculated)",
            "approved": "Approved (Yes/No)",
            "seed_xp_locked": "SeedXP_Locked",
            "notes": "Notes"
          },
          "recommendedAppBehavior": "If approved==Yes and seed_xp_locked is present, inject one seed event (ActionID='SEED-INIT') with xp_override=seed_xp_locked for auditability; do not directly edit ledger totals."
        }
      },
      "derivedViews": {
        "weeklySummary": {
          "sourceSheet": "WeeklySummary",
          "doNotImportAsTruth": true,
          "computeFrom": [
            "events",
            "actions",
            "settings"
          ],
          "logic": {
            "routineXP_raw": "sum events where earn_type=='Routine' per member/week",
            "routineXP_counted": "min(routineXP_raw, RoutineWeeklyCapXP)",
            "milestoneXP_raw": "sum events where earn_type in ('Milestone','Achievement','Boss') per member/week",
            "totalXP_week": "routineXP_counted + milestoneXP_raw",
            "coins_raw_week": "sum coins from verified events per member/week",
            "coins_counted_week": "optional (no weekly coin cap in workbook)"
          }
        },
        "monthlySummary": {
          "sourceSheet": "MonthlySummary",
          "doNotImportAsTruth": true,
          "computeFrom": [
            "events",
            "actions",
            "settings"
          ],
          "logic": {
            "coins_raw_month": "sum coins from verified events per member/month",
            "coins_counted_month": "min(coins_raw_month, MonthlyCoinCap)",
            "worth_rm": "coins_counted_month * CoinValueRM"
          }
        },
        "ledger": {
          "sourceSheet": "Ledger",
          "doNotImportAsTruth": true,
          "computeFrom": [
            "weeklySummary",
            "monthlySummary",
            "seedPlacement"
          ],
          "logic": {
            "total_xp": "seed_xp + sum weekly totalXP_week",
            "level": "min(100, floor(sqrt(total_xp)))",
            "next_level_xp": "(level+1)^2",
            "xp_to_next": "next_level_xp - total_xp",
            "coins_earned_counted": "sum monthly coins_counted_month",
            "coin_balance": "coins_earned_counted - coins_redeemed"
          }
        }
      }
    }
  }
}
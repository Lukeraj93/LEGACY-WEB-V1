{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacy.plus/schemas/legacyplus-client-xp-rules.v1.json",
  "title": "LEGACY+ Client XP Rules Engine Schema v1",
  "type": "object",
  "required": [
    "metadata",
    "settings",
    "xpCurve",
    "actions"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "systemName",
        "version",
        "timezone",
        "region",
        "effectiveDate"
      ],
      "properties": {
        "systemName": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "sourceWorkbook": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "required": [
        "routineWeeklyCapXP",
        "monthlyCoinCap",
        "coinValueRM",
        "weekStart",
        "countOnlyVerified"
      ],
      "properties": {
        "routineWeeklyCapXP": {
          "type": "integer",
          "minimum": 0
        },
        "monthlyCoinCap": {
          "type": "integer",
          "minimum": 0
        },
        "coinValueRM": {
          "type": "number",
          "minimum": 0
        },
        "weekStart": {
          "type": "string",
          "enum": [
            "MON",
            "SUN"
          ]
        },
        "countOnlyVerified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "xpCurve": {
      "type": "object",
      "required": [
        "type",
        "maxLevel",
        "xpAtMaxLevel",
        "formula",
        "levelFromXP"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "quadratic_n_squared"
          ]
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 1
        },
        "xpAtMaxLevel": {
          "type": "integer",
          "minimum": 1
        },
        "formula": {
          "type": "string"
        },
        "levelFromXP": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "actionId",
          "displayName",
          "category",
          "earnType",
          "xp",
          "coins",
          "verificationRequired"
        ],
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[A-Z0-9\\-]{3,30}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "earnType": {
            "type": "string",
            "enum": [
              "Routine",
              "Milestone",
              "Achievement",
              "Boss"
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "coins": {
            "type": "integer",
            "minimum": 0
          },
          "cap": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "period",
                  "maxCount"
                ],
                "properties": {
                  "period": {
                    "type": "string",
                    "enum": [
                      "None",
                      "Daily",
                      "Weekly",
                      "Monthly",
                      "Quarterly",
                      "Yearly",
                      "OneTime"
                    ]
                  },
                  "maxCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "cooldownDays": {
            "type": "integer",
            "minimum": 0
          },
          "verificationRequired": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}